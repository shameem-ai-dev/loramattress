<div id="modal-size-guide" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog" style="max-width: 800px;">
    <button type="button" class="modal-close-btn" data-action="close-modal" aria-label="Close modal">
      {% render 'icon-close' %}
    </button>
    <div style="text-align: center; margin-bottom: 2rem;">
      <span class="eyebrow">Standard Indian Sizing Reference</span>
      <h3 style="font-size: 2.2rem;">LORA Mattress Size Chart</h3>
      <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 500px; margin: 0.5rem auto 0;">
        Measure your cot's internal edge-to-edge frame dimension before selecting your mattress.
      </p>
    </div>

    <table class="comparison-table">
      <thead>
        <tr>
          <th>Standard Size</th>
          <th>Inches (L × W)</th>
          <th>Centimeters (L × W)</th>
          <th>Best Suited For</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Single</strong></td>
          <td>72" × 36" or 75" × 36"</td>
          <td>183 × 91 cm</td>
          <td>Solo sleepers, children, daybeds</td>
        </tr>
        <tr>
          <td><strong>Diwan / Double</strong></td>
          <td>72" × 48" or 75" × 48"</td>
          <td>183 × 122 cm</td>
          <td>Guest rooms, studio apartments</td>
        </tr>
        <tr>
          <td><strong>Queen</strong></td>
          <td>78" × 60"</td>
          <td>198 × 152 cm</td>
          <td>Couples with standard master bedrooms</td>
        </tr>
        <tr>
          <td><strong>King</strong></td>
          <td>78" × 72"</td>
          <td>198 × 183 cm</td>
          <td>Couples seeking spacious luxury & family rest</td>
        </tr>
        <tr>
          <td><strong>Custom Indian</strong></td>
          <td>Any bespoke size</td>
          <td>Direct measurement</td>
          <td>Heirloom wooden cots & imported beds</td>
        </tr>
      </tbody>
    </table>

    <div style="margin-top: 2rem; background: var(--bg-primary); padding: 1.25rem 1.5rem; border-radius: 4px; font-size: 0.88rem; color: var(--text-secondary);">
      <strong style="color: var(--color-espresso);">Need a non-standard size?</strong> LORA handcrafts custom dimensions at our workshop. Contact our WhatsApp Sleep Concierge with your cot's exact inner measurements.
    </div>
  </div>
</div>
