<!-- Persistent Comparison Dock -->
<div class="comparison-dock">
  <span style="font-size: 0.9rem; font-weight: 500;">Mattress Comparison <span class="compare-dock-count font-serif">(0/3)</span></span>
  <button type="button" class="btn btn-brass btn-sm" data-action="open-compare-modal">
    View Comparison Table
  </button>
  <button type="button" style="color: rgba(245, 242, 235, 0.7); font-size: 0.8rem; text-decoration: underline;" data-action="clear-compare">
    Clear
  </button>
</div>

<!-- Comparison Full Modal -->
<div id="modal-comparison" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog">
    <button type="button" class="modal-close-btn" data-action="close-modal" aria-label="Close modal">
      {% render 'icon-close' %}
    </button>
    <div style="text-align: center; margin-bottom: 2rem;">
      <span class="eyebrow">Objective Side-by-Side Analysis</span>
      <h3 style="font-size: 2.25rem;">Compare LORA Mattresses</h3>
      <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 540px; margin: 0.5rem auto 0;">
        Compare construction, firmness ratings, materials, and warranty to find your restorative match.
      </p>
    </div>

    <table class="comparison-table">
      <tbody class="comparison-table-body">
        <!-- Dynamically rendered by theme.js -->
      </tbody>
    </table>
  </div>
</div>
