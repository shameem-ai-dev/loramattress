<header class="site-header" role="banner">
  <div class="header-container">
    <a href="/" class="brand-logo-link" aria-label="{{ shop.name | default: 'LORA Mattresses' }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 260 }}" 
             alt="{{ shop.name | default: 'LORA' }}" 
             class="brand-logo-img">
      {% else %}
        <img src="{{ 'lora-logo-transparent.png' | asset_url }}" 
             alt="LORA Mattresses" 
             class="brand-logo-img">
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" role="navigation" aria-label="Primary Navigation">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="header-nav-link {% if link.active %}active{% endif %}">
          {{ link.title }}
        </a>
      {% else %}
        <a href="#the-collection" class="header-nav-link active">The 8 Mattresses</a>
        <a href="#spine-simulator" class="header-nav-link">SpineAlign™ Science</a>
        <a href="#factory-direct" class="header-nav-link">Direct from Factory</a>
        <a href="#sleep-quiz" class="header-nav-link">Sleep Match AI</a>
        <a href="#studios" class="header-nav-link">Sleep Studios</a>
      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- WhatsApp Button -->
      <a href="https://wa.me/{{ settings.whatsapp_number | default: '919876543210' | remove: '+' | remove: ' ' | remove: '-' }}?text={{ settings.whatsapp_default_message | default: 'Hello LORA, I would like guidance selecting a mattress.' | url_encode }}" 
         target="_blank" 
         rel="noopener noreferrer" 
         class="btn btn-whatsapp btn-sm"
         style="border-radius: var(--radius-pill); font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.45rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="#FFFFFF">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Cart Trigger -->
      <button type="button" class="header-action-btn{% if cart.item_count > 0 %} has-items{% endif %}" data-action="open-cart" aria-label="View Sleep Bag">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-count-badge"{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count | default: 0 }}</span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Floating Tech Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
