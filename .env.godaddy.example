# ==============================================================================
# LORA MATTRESS — GoDaddy Hosting Environment Variables Template
# (.env.godaddy.example)
#
# INSTRUCTIONS FOR GODADDY HOSTING:
# 1. Log into your GoDaddy Hosting / cPanel Dashboard.
# 2. Go to "Setup Node.js App" -> select your application -> "Environment Variables" (or "Add Secrets").
# 3. Add each variable name below with your actual credentials.
# 4. After adding or modifying variables, click "RESTART APPLICATION" in GoDaddy
#    so the Node.js runtime reloads the new process.env variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Server-Side Admin Authentication Secret
# Protects administrative API endpoints (payment tests, gateway tests, catalog updates)
ADMIN_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# Obtain from: Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
# API Key ID (format: rzp_live_... for production, or rzp_test_... for sandbox)
RAZORPAY_KEY_ID=

# API Key Secret (used exclusively for server-side HMAC-SHA256 signature verification)
RAZORPAY_KEY_SECRET=

# Gateway Mode: 'live' for real payments, 'test' for sandbox testing
RAZORPAY_MODE=live

# Webhook Secret (optional, from Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Checkout Modal Brand Accent Color (default: #00B4D8)
RAZORPAY_THEME_COLOR=#00B4D8

# ------------------------------------------------------------------------------
# 3. SMS OTP INTEGRATION
# Supported providers: FAST2SMS, MSG91, TWILIO
# ------------------------------------------------------------------------------
# Active SMS provider name
SMS_PROVIDER=FAST2SMS

# Provider API Key / Auth Token
SMS_API_KEY=

# Provider API Secret (required for Twilio / Gupshup, optional for Fast2SMS)
SMS_API_SECRET=

# DLT Approved Sender ID (6 alphabetic characters in India, e.g. LORAMT)
SMS_SENDER_ID=LORAMT

# DLT Approved OTP Message Template ID
SMS_TEMPLATE_ID=

# Twilio Verify (used when the Admin panel SMS provider is set to "Twilio")
# Enter real values ONLY in your hosting panel's environment variables, never in code or chat.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: secret used to sign verified-customer checkout sessions (random 64+ chars).
# If unset, the server generates one and stores it in config/.customer_session_secret.
CUSTOMER_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. WHATSAPP OTP INTEGRATION
# Supported providers: FAST2SMS, META_CLOUD, WATI, GUPSHUP
# ------------------------------------------------------------------------------
# Active WhatsApp provider name (e.g. FAST2SMS or META_CLOUD)
WHATSAPP_PROVIDER=FAST2SMS

# Fast2SMS dedicated API Key (or reuse SMS_API_KEY / WHATSAPP_API_TOKEN)
FAST2SMS_API_KEY=

# Fast2SMS Smart OTP Template ID (from Fast2SMS Dashboard -> Smart OTP section)
# Required for Fast2SMS Smart OTP delivery via WhatsApp
FAST2SMS_OTP_ID=

# Fast2SMS WhatsApp Message/Template ID (Alternative for direct WhatsApp Message API)
FAST2SMS_WHATSAPP_MESSAGE_ID=

# Meta Permanent System User Access Token (Only if using Meta Cloud API)
WHATSAPP_API_TOKEN=

# Meta WhatsApp Business Phone Number ID (Only if using Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account Number with country code (e.g. +919072616423)
WHATSAPP_BUSINESS_NUMBER=

# Approved WhatsApp OTP Template Name (e.g. lora_auth_otp)
WHATSAPP_TEMPLATE_NAME=lora_auth_otp

# ------------------------------------------------------------------------------
# 5. EMAIL OTP INTEGRATION (SMTP)
# ------------------------------------------------------------------------------
# SMTP Server hostname (e.g. smtp.godaddy.com, smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Account Username / Email Address
SMTP_USER=

# SMTP Account Password or App Password
SMTP_PASS=

# Sender Name and Address (e.g. "LORA Mattress" <support@loramattress.com>)
SMTP_FROM=

# ------------------------------------------------------------------------------
# 6. DATABASE & PERSISTENT STORAGE (OPTIONAL)
# On GoDaddy, files under /config and /assets/uploads persist permanently on disk.
# If connecting an external database, specify the connection string here:
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 7. VERCEL-SPECIFIC (NOT REQUIRED ON GODADDY)
# GoDaddy Node.js uses local persistent disk storage (/assets/uploads).
# Only needed if explicitly routing uploads to Vercel Blob cloud storage:
# ------------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=
