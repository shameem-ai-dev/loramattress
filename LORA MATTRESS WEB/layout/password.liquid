<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    {% render 'meta-tags' %}
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body class="template-password" style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg-primary); text-align: center; padding: 2rem;">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
