<section class="blog-template" style="padding: 5rem 0 7rem;">
  <div class="container">
    <div class="section-header text-center" style="margin-bottom: 4rem;">
      <span class="eyebrow">The Sleep Journal</span>
      <h1 class="font-serif" style="font-size: 3.25rem;">Essays on Rest & Recovery</h1>
      <p style="max-width: 540px; margin: 0 auto;">Architectural acoustics, natural materials, and circadian rhythm science curated by the LORA Sleep Studio.</p>
    </div>

    <div class="products-grid">
      <!-- Article 1 -->
      <article class="comfort-card">
        <div class="comfort-card-media">
          <img src="{{ 'hero-bedroom-dawn.jpg' | asset_url }}" alt="Circadian lighting" class="comfort-card-img" width="600" height="450">
        </div>
        <div class="comfort-card-body">
          <span class="eyebrow">Sleep Science</span>
          <h3 class="font-serif" style="font-size: 1.5rem; margin-bottom: 0.5rem;">The Architecture of Morning Light</h3>
          <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">How calibrated dawn luminance influences natural cortisol release and sleep cycle completion.</p>
          <a href="#" class="btn btn-secondary btn-sm" style="margin-top: auto;">Read Essay →</a>
        </div>
      </article>

      <!-- Article 2 -->
      <article class="comfort-card">
        <div class="comfort-card-media">
          <img src="{{ 'material-natural-latex.jpg' | asset_url }}" alt="Natural latex breathability" class="comfort-card-img" width="600" height="450">
        </div>
        <div class="comfort-card-body">
          <span class="eyebrow">Materials</span>
          <h3 class="font-serif" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Why Natural Latex Outperforms Synthetic Foam</h3>
          <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">Open-cell botanical rubber tree sap and how pin-core aeration regulates thermal comfort.</p>
          <a href="#" class="btn btn-secondary btn-sm" style="margin-top: auto;">Read Essay →</a>
        </div>
      </article>

      <!-- Article 3 -->
      <article class="comfort-card">
        <div class="comfort-card-media">
          <img src="{{ 'lifestyle-editorial.jpg' | asset_url }}" alt="Restful bedrooms" class="comfort-card-img" width="600" height="450">
        </div>
        <div class="comfort-card-body">
          <span class="eyebrow">Design</span>
          <h3 class="font-serif" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Designing the Bedroom as a Sensory Sanctuary</h3>
          <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">Texture, linen drapery, and low-color-temperature lighting for calmer nervous systems.</p>
          <a href="#" class="btn btn-secondary btn-sm" style="margin-top: auto;">Read Essay →</a>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Blog",
  "settings": []
}
{% endschema %}
