<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Newsletter -->
      <div class="footer-brand">
        <h3 class="font-serif">{{ shop.name | default: 'LORA' }}</h3>
        <p>
          Restful, refined mattresses handcrafted with pure botanical latex, zoned pocket coils, and Belgian linen. Better nights. Better mornings.
        </p>

        <div style="margin-top: 1.75rem;">
          <span style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--color-brass); letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">The Sleep Journal</span>
          <p style="font-size: 0.82rem; color: rgba(245, 242, 235, 0.65); margin-bottom: 0.75rem;">Receive private invitations, sleep architecture essays, and exclusive privileges.</p>
          
          <form class="footer-newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to The Sleep Journal.');">
            <input type="email" placeholder="Enter your email address" class="footer-input" required aria-label="Email for newsletter">
            <button type="submit" class="btn btn-brass btn-sm">Join</button>
          </form>
        </div>
      </div>

      <!-- Col 2: Sleep Sanctuary -->
      <div>
        <h4 class="footer-heading">Collection</h4>
        <ul class="footer-links">
          <li><a href="#featured-mattresses">The LORA Organic Balance</a></li>
          <li><a href="#featured-mattresses">The LORA Serene Cloud</a></li>
          <li><a href="#featured-mattresses">The LORA Ortho Restore</a></li>
          <li><a href="#find-your-comfort">Mattress Finder Quiz</a></li>
          <li><a href="#inside-comfort">Materials & Architecture</a></li>
          <li><a href="javascript:void(0)" data-action="open-size-guide">Indian Cot Size Chart</a></li>
        </ul>
      </div>

      <!-- Col 3: Experience & Care -->
      <div>
        <h4 class="footer-heading">Customer Care</h4>
        <ul class="footer-links">
          <li><a href="#reasons-to-choose">Direct Factory Transparency</a></li>
          <li><a href="#reasons-to-choose">10-Year Warranty Terms</a></li>
          <li><a href="#reasons-to-choose">White-Glove Setup Guide</a></li>
          <li><a href="#faq">Frequently Asked Questions</a></li>
          <li><a href="#showrooms">Sleep Studios (Mumbai, BLR, DEL)</a></li>
          <li><a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener noreferrer">WhatsApp Sleep Concierge</a></li>
        </ul>
      </div>

      <!-- Col 4: Concierge & Studio Support -->
      <div>
        <h4 class="footer-heading">Sleep Concierge</h4>
        <p style="font-size: 0.85rem; color: rgba(245, 242, 235, 0.7); margin-bottom: 1rem; line-height: 1.6;">
          Have questions regarding mattress depth, room elevator access, or custom wooden cots?
        </p>
        <p style="font-size: 0.85rem; color: var(--color-sand); margin-bottom: 0.5rem;">
          <strong>Direct Line:</strong> {{ settings.support_phone | default: '1800-200-5672 (9am - 8pm IST)' }}
        </p>
        <p style="font-size: 0.85rem; color: var(--color-sand); margin-bottom: 1.5rem;">
          <strong>Email:</strong> {{ settings.support_email | default: 'concierge@loramattress.com' }}
        </p>

        <!-- Social Media Links -->
        <div style="display: flex; gap: 1rem; color: rgba(245, 242, 235, 0.75);">
          {% if settings.social_instagram != blank %}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
          {% endif %}
          {% if settings.social_pinterest != blank %}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">Pinterest</a>
          {% endif %}
          {% if settings.social_youtube != blank %}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube</a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'LORA Mattress India Pvt. Ltd.' }} All rights reserved.</span>
        <span style="margin: 0 0.5rem;">•</span>
        <a href="/policies/terms-of-service" style="color: inherit; text-decoration: underline;">Terms of Service</a>
        <span style="margin: 0 0.5rem;">•</span>
        <a href="/policies/privacy-policy" style="color: inherit; text-decoration: underline;">Privacy Policy</a>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <span style="font-size: 0.75rem; color: var(--color-sand);">Currency: <strong>INR (₹)</strong></span>
        <span style="font-size: 0.75rem; opacity: 0.6;">UPI • NetBanking • Visa • Mastercard • No-Cost EMI</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Restful, refined mattresses handcrafted with pure botanical latex, zoned pocket coils, and Belgian linen."
    }
  ]
}
{% endschema %}
