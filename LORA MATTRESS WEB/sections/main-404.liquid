<section class="section-404" style="padding: 9rem 0; text-align: center;">
  <div class="container container-narrow">
    <span class="eyebrow" style="color: var(--color-olive);">Page Not Found</span>
    <h1 class="font-serif" style="font-size: clamp(3rem, 5vw, 4.5rem); margin: 0.5rem 0 1.25rem;">
      Peaceful Slumber Awaits
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto 2.5rem;">
      The page you are looking for has moved or rested. Let us guide you back to our master collection.
    </p>

    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="#featured-mattresses" class="btn btn-secondary">Explore Mattresses</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": []
}
{% endschema %}
