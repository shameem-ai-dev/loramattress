<section class="reasons-section" id="reasons-to-choose">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow" style="color: var(--color-brass);">Direct From Source • Proven Excellence</span>
      <h2 class="font-serif">Why Choose LORA?</h2>
      <p>Engineered for Comfort. Built for Better Sleep. Handcrafted directly in our state-of-the-art facility without retail middlemen markups.</p>
    </div>

    <!-- Official Brand Proof Points from PDF Page 9 -->
    <div class="proof-metrics-grid">
      <!-- Metric 1 -->
      <div class="proof-metric-box">
        <span class="proof-stat-number">5,00,000+</span>
        <span class="proof-stat-label">Satisfied Customers</span>
        <p class="proof-stat-subtext">Resting comfortably on LORA mattresses across every major Indian city.</p>
      </div>

      <!-- Metric 2 -->
      <div class="proof-metric-box">
        <span class="proof-stat-number font-serif" style="font-size: 2.3rem;">Direct from Factory</span>
        <span class="proof-stat-label">From Our Factory to Your Home</span>
        <p class="proof-stat-subtext">Direct from LORA. Highest quality, honest direct pricing, and uncompromised value.</p>
      </div>

      <!-- Metric 3 -->
      <div class="proof-metric-box">
        <span class="proof-stat-number font-serif">Up to 15 Yrs</span>
        <span class="proof-stat-label">Comprehensive Warranty</span>
        <p class="proof-stat-subtext">Model-dependent structural coverage (3, 5, 10, 12, and 15 years) against sagging or flaws.</p>
      </div>

      <!-- Metric 4 -->
      <div class="proof-metric-box">
        <span class="proof-stat-number font-serif" style="font-size: 2.3rem;">Google Rated</span>
        <span class="proof-stat-label">Real Customers. Real Experiences.</span>
        <p class="proof-stat-subtext">Transparent reviews and verified ratings from homeowners sleeping better every night.</p>
      </div>
    </div>

    <!-- Bajaj Finserv & Factory Direct Assurance Banner -->
    <div style="margin-top: 3.5rem; background: var(--bg-surface); border: 1px solid var(--border-brass); border-radius: 4px; padding: 2.5rem 3rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
      <div style="max-width: 620px;">
        <span class="eyebrow" style="color: var(--color-olive);">Flexible Financing</span>
        <h3 class="font-serif" style="font-size: 1.85rem; margin-bottom: 0.4rem;">Bajaj Finserv Easy EMI Options Available</h3>
        <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
          Invest in your restorative sleep with 0% interest and hassle-free monthly installments. Quality, Value, and Confidence direct from the factory.
        </p>
      </div>

      <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <a href="#featured-mattresses" class="btn btn-primary">
          Find Your Mattress
        </a>
        <a href="#showrooms" class="btn btn-secondary">
          Visit a Showroom
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose LORA",
  "settings": []
}
{% endschema %}
